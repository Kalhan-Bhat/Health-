# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LLM ---
# Verify the current model list at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
# Use Groq Structured Outputs (json_schema) instead of JSON mode. Only some models support it.
GROQ_USE_JSON_SCHEMA=false

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=data/index
KB_DIR=knowledge_base
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Upload limits ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
MAX_REPORT_CHARS=24000
MIN_EXTRACTED_CHARS=80

# --- App ---
# development | production (production hides /docs)
APP_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Simple in-memory rate limit per client IP (requests per minute). 0 disables it.
RATE_LIMIT_PER_MINUTE=20
